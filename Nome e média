#include <stdio.h>
#include <stdlib.h>

int main() {
	
	char nome [50];
  float nota1;
	float nota2;
	float media;

    printf("Digite o nome do aluno: ");
    scanf("%s", nome); 

    printf("Digite a primeira nota: ");
    scanf("%f", &nota1);

    printf("Digite a segunda nota: ");
    scanf("%f", &nota2);

    media = (nota1 + nota2) / 2;

    printf("\n***** Media *****\n");
    printf("Aluno(a):%s\n", nome);
    printf("Media: %.2f\n", media);
	return 0;
}
